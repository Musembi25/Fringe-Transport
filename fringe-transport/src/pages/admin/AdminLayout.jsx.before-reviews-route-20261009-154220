import { useState } from "react";
import { NavLink, Outlet, useNavigate } from "react-router-dom";
import {
  Activity,
  CalendarDays,
  CarFront,
  ChevronDown,
  ExternalLink,
  LayoutDashboard,
  LogOut,
  Menu,
  Tags,
  ShieldCheck,
  X,
} from "lucide-react";
import { supabase } from "../../lib/supabase";
import "./admin.css";

const navItems = [
  { label: "Overview", to: "/admin", icon: LayoutDashboard, end: true },
  { label: "Bookings", to: "/admin/bookings", icon: CalendarDays },
  { label: "Services & Fares", to: "/admin/services-fares", icon: Tags },
];

export default function AdminLayout() {
  const navigate = useNavigate();
  const [mobileOpen, setMobileOpen] = useState(false);
  const [signingOut, setSigningOut] = useState(false);

  async function logout() {
    setSigningOut(true);
    const { error } = await supabase.auth.signOut();

    if (error) {
      setSigningOut(false);
      window.alert("Unable to sign out: " + error.message);
      return;
    }

    navigate("/admin/login", { replace: true });
  }

  const sidebar = (
    <div className="flex h-full flex-col bg-[#171717] text-white">
      <div className="flex h-[82px] items-center justify-between border-b border-white/10 px-6">
        <a href="/admin" className="flex items-center gap-3">
          <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#D97706] text-sm font-black">
            FT
          </span>
          <span>
            <span className="block text-sm font-bold tracking-[0.12em]">
              FRINGE
            </span>
            <span className="mt-0.5 block text-[9px] font-semibold tracking-[0.25em] text-white/45">
              OPERATIONS
            </span>
          </span>
        </a>
        <button
          type="button"
          onClick={() => setMobileOpen(false)}
          className="rounded-lg p-2 text-white/60 hover:bg-white/10 lg:hidden"
          aria-label="Close navigation"
        >
          <X size={20} />
        </button>
      </div>

      <div className="px-4 pt-7">
        <p className="px-3 pb-3 text-[10px] font-bold uppercase tracking-[0.22em] text-white/35">
          Workspace
        </p>
        <nav className="space-y-1">
          {navItems.map(({ label, to, icon: Icon, end }) => (
            <NavLink
              key={to}
              to={to}
              end={end}
              onClick={() => setMobileOpen(false)}
              className={({ isActive }) =>
                `flex items-center gap-3 rounded-xl px-3.5 py-3 text-sm font-medium transition ${
                  isActive
                    ? "bg-[#D97706] text-white shadow-lg shadow-black/10"
                    : "text-white/60 hover:bg-white/[0.07] hover:text-white"
                }`
              }
            >
              <Icon size={18} strokeWidth={1.8} />
              {label}
            </NavLink>
          ))}
        </nav>
      </div>

      <div className="mx-6 mt-8 border-t border-white/10 pt-6">
        <p className="mb-4 px-1 text-[10px] font-bold uppercase tracking-[0.22em] text-white/35">
          Quick access
        </p>
        <a
          href="/"
          target="_blank"
          rel="noreferrer"
          className="flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-white/60 transition hover:bg-white/[0.07] hover:text-white"
        >
          <ExternalLink size={17} />
          View website
        </a>
      </div>

      <div className="mt-auto p-4">
        <div className="mb-4 flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.04] p-3">
          <span className="flex h-9 w-9 items-center justify-center rounded-full bg-[#D97706]/20 text-[#F59E0B]">
            <ShieldCheck size={18} />
          </span>
          <span className="min-w-0">
            <span className="block text-xs font-semibold">Admin session</span>
            <span className="mt-1 block text-[10px] text-white/40">
              Access verified
            </span>
          </span>
          <span className="ml-auto h-2 w-2 rounded-full bg-emerald-400" />
        </div>

        <button
          type="button"
          disabled={signingOut}
          onClick={logout}
          className="flex w-full items-center gap-3 rounded-xl px-3 py-3 text-sm text-white/60 transition hover:bg-white/[0.07] hover:text-white disabled:opacity-50"
        >
          <LogOut size={17} />
          {signingOut ? "Signing out..." : "Sign out"}
        </button>
      </div>
    </div>
  );

  return (
    <div className="ft-admin min-h-screen bg-[#F7F6F2] text-[#171717]">
      <aside className="fixed inset-y-0 left-0 z-30 hidden w-[258px] lg:block">
        {sidebar}
      </aside>

      {mobileOpen && (
        <div className="fixed inset-0 z-50 lg:hidden">
          <button
            type="button"
            className="absolute inset-0 bg-black/50"
            onClick={() => setMobileOpen(false)}
            aria-label="Close navigation overlay"
          />
          <aside className="absolute inset-y-0 left-0 w-[280px] shadow-2xl">
            {sidebar}
          </aside>
        </div>
      )}

      <div className="min-h-screen lg:pl-[258px]">
        <header className="sticky top-0 z-20 flex h-[72px] items-center justify-between border-b border-neutral-200/80 bg-[#F7F6F2]/95 px-4 backdrop-blur-xl sm:px-7 lg:px-10">
          <div className="flex items-center gap-3">
            <button
              type="button"
              onClick={() => setMobileOpen(true)}
              className="rounded-lg border border-neutral-200 bg-white p-2 lg:hidden"
              aria-label="Open navigation"
            >
              <Menu size={19} />
            </button>
            <div>
              <p className="text-sm font-semibold">Transport management</p>
              <p className="mt-0.5 hidden text-[11px] text-neutral-500 sm:block">
                Fringe Transport / Administration
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <span className="hidden items-center gap-2 rounded-full border border-neutral-200 bg-white px-3 py-2 text-[11px] font-medium text-neutral-600 sm:flex">
              <Activity size={14} className="text-emerald-600" />
              System connected
            </span>
            <span className="flex h-9 w-9 items-center justify-center rounded-full bg-[#171717] text-xs font-bold text-white">
              FT
            </span>
          </div>
        </header>

        <main className="mx-auto max-w-[1600px] px-4 py-7 sm:px-7 sm:py-9 lg:px-10">
          <Outlet />
        </main>
      </div>
    </div>
  );
}
